{
  "name": "floatingtodo",
  "version": "0.1.1",
  "private": true,
  "description": "Frameless Electron desktop todo widget.",
  "author": "FloatingTODO",
  "homepage": "https://github.com/whyself/FloatingTODO",
  "repository": {
    "type": "git",
    "url": "https://github.com/whyself/FloatingTODO.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Remove-Item Env:ELECTRON_RUN_AS_NODE -ErrorAction SilentlyContinue; electron .\"",
    "start:mac": "ELECTRON_RUN_AS_NODE= electron .",
    "start:linux": "ELECTRON_RUN_AS_NODE= electron --ozone-platform=x11 .",
    "start:linux:wayland": "ELECTRON_RUN_AS_NODE= electron --ozone-platform=wayland .",
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1",
    "smoke": "npm run check",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:ELECTRON_BUILDER_CACHE=(Join-Path $PWD '.cache/electron-builder'); electron-builder --win portable; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; powershell -NoProfile -ExecutionPolicy Bypass -File scripts/set-exe-icon.ps1\"",
    "dist:mac": "electron-builder --mac",
    "dist:mac:arm64": "electron-builder --mac --arm64",
    "dist:mac:x64": "electron-builder --mac --x64",
    "dist:linux": "electron-builder --linux",
    "dist:linux:deb": "electron-builder --linux deb",
    "dist:linux:rpm": "electron-builder --linux rpm",
    "dist:linux:AppImage": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "io.github.whyself.floatingtodo",
    "productName": "FloatingTODO",
    "directories": {
      "output": "dist"
    },
    "artifactName": "FloatingTODO ${version}.${ext}",
    "afterPack": "scripts/after-pack.js",
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "portable",
      "signAndEditExecutable": false
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": ["AppImage", "deb", "rpm"],
      "category": "Utility"
    },
    "nsis": {
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1"
  }
}
